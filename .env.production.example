# Dokploy writes these values to .env beside compose.production.yml.
POSTGRES_USER=dollz
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_DB=dollz

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=100000000
IMAGE_MAX_DIMENSION=10000
IMAGE_OPTIMIZED_MAX_WIDTH=2000
IMAGE_THUMBNAIL_WIDTH=400

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
JWT_ISSUER=dollz-api
JWT_AUDIENCE=dollz-admin
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_ACCESS_COOKIE_NAME=dollz_admin_access
ADMIN_REFRESH_COOKIE_NAME=dollz_admin_refresh
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

TURNSTILE_SECRET_KEY=replace-with-your-private-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-public-turnstile-site-key

ALLOWED_ORIGINS=https://dollz.example.com
NEXT_PUBLIC_SITE_URL=https://dollz.example.com
NEXT_PUBLIC_BUILD_YOUR_OWN_SLUG=build-your-own-doll

