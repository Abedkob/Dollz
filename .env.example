NODE_ENV=development

DATABASE_URL=postgresql://dollz:dollz@localhost:5432/dollz
TEST_DATABASE_URL=postgresql://dollz:dollz@localhost:5432/dollz_test

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

STORAGE_ROOT=./storage
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=100000000
IMAGE_MAX_DIMENSION=10000
IMAGE_OPTIMIZED_MAX_WIDTH=2000
IMAGE_THUMBNAIL_WIDTH=400
API_PORT=3001

# Replace these placeholders with separate, randomly generated secrets.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
JWT_ISSUER=dollz-api
JWT_AUDIENCE=dollz-admin
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

ADMIN_ACCESS_COOKIE_NAME=dollz_admin_access
ADMIN_REFRESH_COOKIE_NAME=dollz_admin_refresh
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15

# Cloudflare values are deployment-specific; never expose the secret in NEXT_PUBLIC_*.
TURNSTILE_SECRET_KEY=replace-with-your-private-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-public-turnstile-site-key

ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
API_INTERNAL_URL=http://localhost:3001

# Public canonical origin of the storefront (no trailing slash). Drives SEO
# metadata: canonical URLs, sitemap.xml, robots.txt, llms.txt, Open Graph, and
# JSON-LD. Inlined into the client bundle at build time, so restart the web dev
# server / rebuild after changing it. Set to the production domain at deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slug of the one catalog product used by the /customize page. Leave unset
# until that product exists; the storefront hides "Build your own" entry
# points until this is configured.
NEXT_PUBLIC_BUILD_YOUR_OWN_SLUG=

# Bootstrap credentials are intentionally omitted. Set ADMIN_BOOTSTRAP_EMAIL and
# ADMIN_BOOTSTRAP_PASSWORD only in the shell running `pnpm admin:create`.
